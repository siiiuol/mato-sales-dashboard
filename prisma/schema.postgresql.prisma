// Generated by prepare-postgres.mjs. Do not edit; change schema.prisma instead.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                          String    @id @default(cuid())
  name                        String
  address                     String?
  city                        String?
  province                    String?
  lat                         Float?
  lng                         Float?
  category                    String?
  phone                       String?
  email                       String?
  website                     String?
  mapsUrl                     String?
  placeId                     String?   @unique
  intelligenceEstablishmentId String?   @unique
  intelligenceEnterpriseId    String?
  establishmentName           String?
  enterpriseName              String?
  source                      String    @default("lead_bot")
  sourceVersion               String?
  score                       Int       @default(0)
  timingScore                 Int       @default(0)
  distanceKm                  Float?
  tier                        String?
  reason                      String?
  evidenceSummary             String?
  recommendedMachine          String?
  recommendedAngle            String?
  phoneOpener                 String?
  discoveryQuestions          String?
  likelyObjection             String?
  outreachPrep                String?
  status                      String    @default("NEW")
  nextActionAt                DateTime?
  lastTouchedAt               DateTime?
  notes                       String?
  complianceStatus            String    @default("PENDING")
  doNotContact                Boolean   @default(false)
  suppressionReason           String?
  suppressionCheckedAt        DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  outreach    OutreachEvent[]
  customer    Customer?
  deals       Deal[]
  tasks       Task[]
  meetings    Meeting[]
  quotes      Quote[]
  emailDrafts EmailDraft[]
}

model OutreachEvent {
  id             String    @id @default(cuid())
  leadId         String
  type           String    @default("CALL")
  outcome        String?
  note           String?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  createdById    String?

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])
}

model DetectionRun {
  id           String    @id @default(cuid())
  zone         String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdCount Int       @default(0)
  skippedCount Int       @default(0)
  status       String    @default("running")
  detail       String?
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  province  String?
  phone     String?
  email     String?
  website   String?
  notes     String?
  leadId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead      Lead?      @relation(fields: [leadId], references: [id])
  deals     Deal[]
  purchases Purchase[]
  tasks     Task[]
  meetings  Meeting[]
  quotes    Quote[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  line        String
  sku         String?
  description String?
  specs       String?
  listPrice   Float
  cost        Float    @default(0)
  recurring   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dealLines DealLine[]
  purchases Purchase[]
}

model Deal {
  id                   String    @id @default(cuid())
  title                String
  stage                String    @default("QUALIFIED")
  leadId               String?
  customerId           String?
  expectedCloseAt      DateTime?
  nextStep             String?
  discountPercent      Float     @default(0)
  notes                String?
  wonAt                DateTime?
  expectedMachineCount Int       @default(1)
  recurringValue       Float     @default(0)
  probability          Int       @default(25)
  grossMargin          Float?
  lossReason           String?
  lastActivityAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lead     Lead?      @relation(fields: [leadId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  lines    DealLine[]
  tasks    Task[]
  meetings Meeting[]
  quotes   Quote[]
}

model DealLine {
  id        String @id @default(cuid())
  dealId    String
  productId String
  qty       Int    @default(1)
  unitPrice Float

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Purchase {
  id          String   @id @default(cuid())
  customerId  String
  productId   String
  qty         Int      @default(1)
  unitPrice   Float
  purchasedAt DateTime @default(now())
  notes       String?
  dealLineId  String?  @unique

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("sales")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks       Task[]
  outreach    OutreachEvent[]
  auditEvents AuditEvent[]
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("OPEN")
  priority     Int       @default(50)
  dueAt        DateTime?
  completedAt  DateTime?
  leadId       String?
  customerId   String?
  dealId       String?
  assignedToId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation(fields: [assignedToId], references: [id])
}

model Meeting {
  id         String    @id @default(cuid())
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  location   String?
  notes      String?
  status     String    @default("SCHEDULED")
  leadId     String?
  customerId String?
  dealId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Quote {
  id              String    @id @default(cuid())
  number          String    @unique
  status          String    @default("DRAFT")
  validUntil      DateTime?
  notes           String?
  discountPercent Float     @default(0)
  leadId          String?
  customerId      String?
  dealId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead     Lead?       @relation(fields: [leadId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  deal     Deal?       @relation(fields: [dealId], references: [id])
  lines    QuoteLine[]
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  sku         String?
  qty         Int     @default(1)
  unitPrice   Float
  unitCost    Float   @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model EmailDraft {
  id         String    @id @default(cuid())
  leadId     String
  subject    String
  body       String
  status     String    @default("PREPARED")
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

model AppSettings {
  id                  String @id @default("default")
  businessName        String @default("MATO")
  currency            String @default("EUR")
  timezone            String @default("Europe/Brussels")
  placesApiKey        String @default("")
  detectionCategories String @default("[\"bakery\",\"butcher\",\"patisserie\",\"traiteur\",\"chocolatier\",\"florist\",\"farm shop\"]")
  enabledZones        String @default("[\"Antwerpen\",\"Oost-Vlaanderen\",\"West-Vlaanderen\",\"Vlaams-Brabant\",\"Limburg\"]")
  exclusionRadiusKm   Float  @default(0.5)
  pitchTemplates      String @default("{}")
  accent              String @default("green")
}
