DEBUG=false
LEAD_BOT_API_KEY=replace-with-a-long-random-server-secret
LEARNING_SERVICE_KEY=replace-with-an-independent-random-service-secret
CORS_ORIGINS=http://localhost:3000
KBO_INGESTION_ROOT=./data/kbo
NACE_VERSIONS=2003,2008,2025
REDIS_URL=
