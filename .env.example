DATABASE_URL="file:./dev.db"

# Required in production. Generate at least 32 random bytes.
SESSION_SECRET="replace-with-a-long-random-session-secret"

# Seeded local admin. The local defaults are admin@mato.local / mato-admin-dev.
# Set either a plaintext password for one-time seeding, or a bcrypt hash.
MATO_ADMIN_EMAIL="admin@mato.local"
MATO_ADMIN_NAME="MATO Admin"
MATO_ADMIN_PASSWORD="replace-for-shared-environments"
# MATO_ADMIN_PASSWORD_HASH="$2b$12$..."

# Server-only lead-bot bridge. Never prefix these with NEXT_PUBLIC_.
# Free path: leave Google/OpenAI empty on the lead-bot; CRM Scan uses OpenStreetMap.
LEAD_BOT_URL="http://127.0.0.1:8000"
LEAD_BOT_API_KEY="mato-dev-key"
# Dedicated server-to-server key for immutable CRM outcome ingestion.
LEARNING_SERVICE_KEY="replace-with-an-independent-random-service-secret"

# Stable across production instances when Server Actions are deployed.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# PostgreSQL production example (use with prisma/prepare-postgres.mjs):
# DATABASE_URL="postgresql://user:password@host:5432/mato?schema=public"
# DIRECT_URL="postgresql://user:password@host:5432/mato?schema=public"
#
# Daily GitHub backup workflow:
# BACKUP_DATABASE_URL="postgresql://backup-user:password@host:5432/mato?schema=public"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
